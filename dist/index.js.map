{
    "name": "mailauth",
    "version": "7.2.0",
    "description": "Email authentication library for Node.js",
    "main": "lib/mailauth.js",
    "types": "index.d.ts",
    "scripts": {
        "test": "eslint \"lib/**/*.js\" \"test/**/*.js\" && mocha --recursive \"./test/**/*-test.js\" --reporter spec",
        "coverage": "c8 mocha --recursive \"./test/**/*-test.js\" --reporter dot",
        "coverage:check": "c8 check-coverage",
        "mutation": "stryker run",
        "format": "prettier --write .",
        "build-source": "rm -rf node_modules package-lock.json && npm install && npm run licenses && rm -rf node_modules package-lock.json && npm install --production && rm -rf package-lock.json",
        "build-dist": "pkg --compress Brotli package.json && rm -rf package-lock.json && npm install && node winconf.js",
        "build-dist-fast": "pkg --debug package.json && npm install && node winconf.js",
        "licenses": "license-report --only=prod --output=table --config license-report-config.json > licenses.txt",
        "update": "rm -rf node_modules package-lock.json && npx ncu -u && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/mailauth.git"
    },
    "keywords": [
        "rfc822",
        "email",
        "dkim",
        "spf",
        "arc",
        "dmarc",
        "bimi",
        "mta-sts"
    ],
    "author": "Postal Systems OÜ",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/postalsys/mailauth/issues"
    },
    "homepage": "https://github.com/postalsys/mailauth",
    "devDependencies": {
        "@stryker-mutator/core": "10.0.0",
        "c8": "12.0.0",
        "chai": "4.4.1",
        "eslint": "10.12.0",
        "eslint-config-nodemailer": "1.2.0",
        "eslint-config-prettier": "10.1.8",
        "fast-check": "4.10.2",
        "js-yaml": "5.4.3",
        "license-report": "6.8.6",
        "mbox-reader": "1.2.0",
        "mocha": "12.0.3",
        "prettier": "3.9.9",
        "resedit": "3.1.0"
    },
    "dependencies": {
        "@postalsys/vmc": "1.1.5",
        "commander": "15.0.0",
        "fast-xml-parser": "5.11.2",
        "ipaddr.js": "2.5.0",
        "joi": "18.2.9",
        "libmime": "5.4.7",
        "nodemailer": "10.0.16",
        "punycode.js": "2.3.1",
        "tldts": "7.4.18",
        "undici": "8.11.2"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "bin": {
        "mailauth": "bin/mailauth.js"
    },
    "pkg": {
        "assets": [
            "licenses.txt",
            "LICENSE.txt"
        ],
        "targets": [
            "node24-linux-x64",
            "node24-macos-x64",
            "node24-macos-arm64",
            "node24-win-x64"
        ],
        "outputPath": "ee-dist"
    },
    "overrides": {
        "qs": "6.16.0"
    }
}
